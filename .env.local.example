# Notion photo blog. Copy to .env.local and fill in.
# 1. Create an integration: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# 2. Open your Photos database as a full page; the ID is the 32-char
#    string in the URL: notion.so/<workspace>/<THIS_PART>?v=...
NOTION_PHOTOS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
